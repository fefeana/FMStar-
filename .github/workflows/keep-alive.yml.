name: Keep Render Server Awake

on:
  schedule:
    - cron: '*/10 * * * *' # هيشتغل أوتوماتيك كل 10 دقايق
  workflow_dispatch: # تقدر تشغليه يدوياً لو حبيتي

jobs:
  ping-server:
    runs-on: ubuntu-latest
    steps:
      - name: Ping FMStar Render Server
        run: |
          echo "⏰ جاري إرسال إشارة صحوة للسيرفر..."
          curl -s --max-time 30 https://fmstar-ai-studio.onrender.com/ > /dev/null
          echo "✅ تم إرسال الإشارة بنجاح! السيرفر صاحي."
