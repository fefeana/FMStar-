<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FMStarAI Studio</title>
    <style>
        /* ====== Design System Variables ====== */
        :root {
            --canvas: #0E0E10;          /* الخلفية العميقة */
            --surface-1: #1A1A1E;       /* الكروت */
            --surface-2: #23252a;       /* الكروت عند التمرير */
            --hairline: #2A2A2E;        /* الحدود الدقيقة */
            --primary: #8B5CF6;         /* البنفسجي الأساسي */
            --primary-hover: #A855F7;
            --ink: #F7F8F8;             /* النص الفاتح */
            --ink-muted: #8A8F98;       /* النص الثانوي */
            --success: #27A644;
            --danger: #EF4444;
            --font-sans: 'Inter', -apple-system, sans-serif;
            --font-mono: 'JetBrains Mono', ui-monospace, monospace;
        }

        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            background-color: var(--canvas);
            color: var(--ink);
            font-family: var(--font-sans);
            line-height: 1.5;
            display: flex;
            justify-content: center;
            padding: 20px;
            -webkit-font-smoothing: antialiased;
        }

        .app-container { width: 100%; max-width: 480px; display: flex; flex-direction: column; gap: 20px; }

        /* ====== Top Bar ====== */
        .top-bar { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--hairline); padding-bottom: 16px; }
        .brand { font-weight: 700; font-size: 18px; display: flex; align-items: center; gap: 6px; }
        .brand-icon { color: var(--primary); font-size: 20px; }
        
        .gamification-badge { 
            display: flex; align-items: center; gap: 10px; background: var(--surface-1); 
            border: 1px solid var(--hairline); padding: 6px 12px; border-radius: 8px; 
        }
        .pts { font-family: var(--font-mono); font-size: 14px; color: var(--primary-hover); font-weight: 600; }
        .streak { font-size: 12px; color: var(--ink-muted); display: flex; align-items: center; gap: 4px; }

        /* ====== Cards General ====== */
        .card { background: var(--surface-1); border: 1px solid var(--hairline); border-radius: 12px; padding: 20px; }
        .card-header { font-size: 15px; font-weight: 600; margin-bottom: 16px; display: flex; justify-content: space-between; align-items: center; }

        /* ====== LTX Studio Section ====== */
        .studio-title { color: var(--primary-hover); display: flex; align-items: center; gap: 8px; }
        .stream-badge { font-size: 10px; font-family: var(--font-mono); background: rgba(139, 92, 246, 0.15); color: var(--primary-hover); padding: 4px 8px; border-radius: 6px; border: 1px solid rgba(139, 92, 246, 0.3); }
        
        .input-label { font-size: 11px; font-family: var(--font-mono); color: var(--ink-muted); margin-bottom: 6px; display: block; }
        .text-area { 
            width: 100%; background: var(--canvas); border: 1px solid var(--hairline); 
            border-radius: 8px; padding: 12px; color: var(--ink); font-family: var(--font-sans); 
            font-size: 13px; resize: none; outline: none; transition: border-color 0.2s; 
        }
        .text-area:focus { border-color: var(--primary); }

        .controls-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 16px; }
        .select-box { 
            width: 100%; background: var(--canvas); border: 1px solid var(--hairline); 
            border-radius: 8px; padding: 10px; color: var(--ink); font-size: 12px; outline: none; 
        }
        
        .btn-primary {
            width: 100%; background: var(--primary); color: white; border: none;
            padding: 14px; border-radius: 8px; font-weight: 600; font-size: 14px;
            cursor: pointer; transition: background 0.2s; display: flex; justify-content: center; gap: 8px; margin-top: 16px;
        }
        .btn-primary:hover { background: var(--primary-hover); }
        .btn-primary:active { transform: scale(0.98); }

        /* ====== Gamification Section ====== */
        .challenge-box { background: var(--canvas); border: 1px solid var(--hairline); border-radius: 8px; padding: 16px; }
        .challenge-top { display: flex; justify-content: space-between; margin-bottom: 8px; }
        .challenge-name { font-size: 13px; font-weight: 600; color: #F59E0B; }
        .challenge-points { font-family: var(--font-mono); font-size: 11px; color: #3B82F6; background: rgba(59, 130, 246, 0.1); padding: 2px 6px; border-radius: 4px; }
        .challenge-desc { font-size: 11px; color: var(--ink-muted); margin-bottom: 12px; line-height: 1.4; }
        .btn-claim { width: 100%; background: linear-gradient(90deg, #8B5CF6, #06B6D4); color: white; border: none; padding: 10px; border-radius: 6px; font-weight: 600; font-size: 12px; cursor: pointer; }

        /* Leaderboard */
        .leaderboard-row { display: flex; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--hairline); }
        .leaderboard-row:last-child { border-bottom: none; }
        .lb-name { font-size: 13px; font-weight: 500; }
        .lb-pts { font-family: var(--font-mono); font-size: 12px; color: var(--primary-hover); font-weight: 600; }

        /* ====== Apps Grid ====== */
        .apps-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
        .app-tile { 
            background: var(--surface-1); border: 1px solid var(--hairline); border-radius: 12px; 
            padding: 20px; display: flex; flex-direction: column; align-items: center; gap: 10px; cursor: pointer; transition: background 0.2s;
        }
        .app-tile:hover { background: var(--surface-2); }
        .app-icon { font-size: 24px; }
        .app-name { font-family: var(--font-mono); font-size: 11px; color: var(--ink-muted); }

        /* ====== Jimmy & Mira Studio ====== */
        .studio-banner { 
            background: linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(6, 182, 212, 0.1)); 
            border: 1px solid var(--hairline); border-radius: 12px; padding: 24px; 
        }
        .banner-title { font-size: 15px; font-weight: 600; margin-bottom: 6px; }
        .banner-desc { font-size: 12px; color: var(--ink-muted); margin-bottom: 16px; }
        .btn-outline { 
            background: transparent; color: var(--primary-hover); border: 1px solid var(--primary); 
            padding: 8px 16px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; transition: 0.2s;
        }
        .btn-outline:hover { background: rgba(139, 92, 246, 0.1); }
    </style>
    <!-- استدعاء الخطوط -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>

    <div class="app-container">
        
        <!-- Top Bar -->
        <header class="top-bar">
            <div class="brand">
                <span class="brand-icon">✧</span> FMSTAR
            </div>
            <div class="gamification-badge">
                <div class="pts">1,250 PTS</div>
                <div class="streak">🔥 5 أيام</div>
            </div>
        </header>

        <!-- LTX Studio Card -->
        <div class="card">
            <div class="card-header">
                <div class="studio-title">🎬 (LTX-2.5) الاستوديو المرئي</div>
                <div class="stream-badge">Gemini 2.5 Flash</div>
            </div>
            
            <label class="input-label">وصف المشهد المرئي والصوتي:</label>
            <textarea class="text-area" rows="3" placeholder="مثال: مشهد سينمائي لشاعر يلقي إلقاءً حماسياً مع إضاءة خافتة وموسيقى خلفية..."></textarea>

            <div class="controls-grid">
                <div>
                    <label class="input-label">تأثير الصوت (DSP):</label>
                    <select class="select-box">
                        <option>Brass Studio</option>
                        <option>Chunked Stream</option>
                    </select>
                </div>
                <div>
                    <label class="input-label">أبعاد الفيديو:</label>
                    <select class="select-box">
                        <option>(16:9) شاشة عريضة</option>
                        <option>(9:16) ريلز / شورتس</option>
                    </select>
                </div>
            </div>

            <button class="btn-primary" onclick="alert('جاهز للربط!')">
                <span>🚀</span> توليد الفيديو والصوت
            </button>
        </div>

        <!-- Gamification Card -->
        <div class="card">
            <div class="card-header">🎯 التحديات والجوائز اليومية</div>
            
            <div class="challenge-box">
                <div class="challenge-top">
                    <span class="challenge-name">🔥 تحدي هندسة الصوت السحابية</span>
                    <span class="challenge-points">PTS 100+</span>
                </div>
                <div class="challenge-desc">قم بتوليد مقطع صوتي باستخدام خادم Go DSP واستفد من مضاعف السلسلة اليومية.</div>
                <button class="btn-claim">🚀 تحصيل المكافأة</button>
            </div>

            <div style="margin-top: 20px;">
                <div class="card-header" style="margin-bottom: 8px;">🏆 لوحة الصدارة المباشرة</div>
                <div class="leaderboard-row">
                    <span class="lb-name">✨ فيفيانا</span>
                    <span class="lb-pts">2,450</span>
                </div>
                <div class="leaderboard-row">
                    <span class="lb-name">Jimi Audio Bot</span>
                    <span class="lb-pts">1,890</span>
                </div>
                <div class="leaderboard-row">
                    <span class="lb-name">Mira AI</span>
                    <span class="lb-pts">1,250</span>
                </div>
            </div>
        </div>

        <!-- Apps Grid -->
        <div class="apps-grid">
            <div class="app-tile"><span class="app-icon">🤖</span><span class="app-name">AI LAB</span></div>
            <div class="app-tile"><span class="app-icon">🎬</span><span class="app-name">VIDEO</span></div>
            <div class="app-tile"><span class="app-icon">🎵</span><span class="app-name">MUSIC</span></div>
            <div class="app-tile"><span class="app-icon">🎨</span><span class="app-name">DESIGN</span></div>
            <div class="app-tile"><span class="app-icon">📱</span><span class="app-name">APPS</span></div>
            <div class="app-tile"><span class="app-icon">🌍</span><span class="app-name">PUBLISH</span></div>
        </div>

        <!-- Jimmy & Mira Studio -->
        <div class="studio-banner">
            <div class="banner-title">(Gemini & Mira Studio) استوديو جيمي وميرا</div>
            <div class="banner-desc">إنشاء الأغاني الموسيقية وتوليد الإلقاء الشعري بـ 17 لهجة ونمط عالمي.</div>
            <button class="btn-outline">فتح الاستوديو 🚀</button>
        </div>

    </div>

</body>
</html>s="w-8 h-8 rounded-[6px] bg-[#18191a] border border-hairline flex items-center justify-center mb-4 group-hover:border-primary/50 transition-colors">
                    <i data-lucide="mic" class="w-4 h-4 text-primary"></i>
                </div>
                <h3 class="text-[16px] font-semibold text-ink mb-2">Voice Cloning</h3>
                <p class="text-[14px] text-inkSubtle leading-[1.5]">Create realistic AI voices with emotion, timbre, and precise control.</p>
            </div>
            
            <!-- Card 2 -->
            <div class="bg-surface border border-hairline rounded-[12px] p-6 hover:border-[#34343a] transition-colors cursor-pointer group">
                <div class="w-8 h-8 rounded-[6px] bg-[#18191a] border border-hairline flex items-center justify-center mb-4 group-hover:border-primary/50 transition-colors">
                    <i data-lucide="music" class="w-4 h-4 text-primary"></i>
                </div>
                <h3 class="text-[16px] font-semibold text-ink mb-2">Music Generation</h3>
                <p class="text-[14px] text-inkSubtle leading-[1.5]">Compose full tracks, melodies, and harmonies from text prompts instantly.</p>
            </div>

            <!-- Card 3 -->
            <div class="bg-surface border border-hairline rounded-[12px] p-6 hover:border-[#34343a] transition-colors cursor-pointer group">
                <div class="w-8 h-8 rounded-[6px] bg-[#18191a] border border-hairline flex items-center justify-center mb-4 group-hover:border-primary/50 transition-colors">
                    <i data-lucide="sliders" class="w-4 h-4 text-primary"></i>
                </div>
                <h3 class="text-[16px] font-semibold text-ink mb-2">Sound Design</h3>
                <p class="text-[14px] text-inkSubtle leading-[1.5]">Craft cinematic audio effects, ambience, and textures with AI precision.</p>
            </div>
        </section>
    </main>

    <!-- Command Palette (⌘K) Fixed at bottom -->
    <div class="fixed bottom-6 left-1/2 -translate-x-1/2 w-[90%] max-w-lg z-50">
        <div class="bg-surface border border-hairline rounded-[8px] flex items-center px-3 h-12 shadow-[0_8px_30px_rgba(0,0,0,0.5)]">
            <i data-lucide="search" class="w-4 h-4 text-inkSubtle mr-3"></i>
            <input type="text" id="commandInput" placeholder="Type a command or prompt..." class="flex-1 bg-transparent border-none outline-none text-[14px] text-ink placeholder-inkSubtle">
            <div class="flex items-center gap-1">
                <kbd class="px-1.5 py-0.5 rounded-[4px] bg-[#18191a] border border-hairline text-[10px] font-mono text-inkSubtle">⌘</kbd>
                <kbd class="px-1.5 py-0.5 rounded-[4px] bg-[#18191a] border border-hairline text-[10px] font-mono text-inkSubtle">K</kbd>
            </div>
        </div>
    </div>

    <script>
        // Initialize Icons
        lucide.createIcons();

        // Generate Waveform Bars (Linear Style)
        const waveformContainer = document.getElementById('waveform');
        const totalBars = 100;
        const activeIndex = 50; // Center playhead

        for (let i = 0; i < totalBars; i++) {
            const bar = document.createElement('div');
            bar.classList.add('wave-bar');
            
            // Generate a smooth pseudo-random wave
            const height = Math.sin(i * 0.2) * 20 + Math.random() * 40 + 10;
            bar.style.height = `${height}%`;
            
            if (i <= activeIndex) {
                bar.classList.add('active');
            }
            waveformContainer.appendChild(bar);
        }

        // Command Palette Keyboard Shortcut (Cmd+K or Ctrl+K)
        document.addEventListener('keydown', (e) => {
            if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
                e.preventDefault();
                document.getElementById('commandInput').focus();
            }
        });
    </script>
</body>
</html>
        <div class="input-box">
            <input type="text" placeholder="اكتب فكرتك هنا...">
            <button class="btn" onclick="alert('الواجهة شغالة! المحرك هيتربط هنا قريباً.')">Generate ✨</button>
        </div>

        <div class="nav">
            <div class="active">الاستوديو</div>
            <div>مشاريعي</div>
            <div style="background: #8B5CF6; width: 50px; height: 50px; border-radius: 50%; margin-top: -25px; display: flex; align-items: center; justify-content: center; color: white; font-size: 24px;">+</div>
            <div>المكتبة</div>
            <div>حسابي</div>
        </div>
    </div>

    <script>
        const container = document.getElementById('waveform');
        for(let i=0; i<40; i++) {
            let bar = document.createElement('div');
            bar.className = 'wave-bar';
            let h = Math.random() * 100;
            bar.style.height = h + '%';
            if(h < 50) bar.style.backgroundColor = '#1A1A2E';
            container.appendChild(bar);
        }
    </script>
</body>
</html>
