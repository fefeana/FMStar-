services:
  - type: web
    name: fmstar-claude-agent
    runtime: python
    plan: free
    autoDeploy: true

    buildCommand: |
      pip install -r backend/requirements.txt

    startCommand: |
      cd backend && uvicorn fmstar_cloud:app --host 0.0.0.0 --port $PORT

    envVars:
      - key: PYTHON_VERSION
        value: 3.11

      - key: ENVIRONMENT
        value: production

      - key: AGENT_NAME
        value: Claude
