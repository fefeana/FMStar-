services:
  - type: web
    name: fmstar-claude-agent
    runtime: python
    plan: free
    rootDir: claude-agent-server
    buildCommand: pip install -r requirements.txt
    startCommand: python server_3000.py
    autoDeploy: true
    envVars:
      - key: ENVIRONMENT
        value: production
      - key: AGENT_MODE
        value: claude
      - key: PORT
        value: 3000
