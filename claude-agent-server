services:
  - type: web
    name: claude-agent-server
    runtime: python
    plan: free

    buildCommand: |
      pip install -r backend/requirements.txt

    startCommand: |
      cd backend && uvicorn fmstar_cloud:app --host 0.0.0.0 --port $PORT

    envVars:
      - key: PYTHON_VERSION
        value: 3.11

      - key: ENVIRONMENT
        value: production

      - key: AGENT_NAME
        value: Claude

      - key: SECRET_KEY
        sync: false

      - key: OMNIROUTE_BASE_URL
        sync: false

      - key: OMNIROUTE_API_KEY
        sync: false

      - key: GEMINI_API_KEY
        sync: false

      - key: MINIMAX_API_KEY
        sync: false
